# Keep the build context small and keep secrets out of the image.
.git
.gitignore
.venv
venv
env
__pycache__
*.py[cod]
.pytest_cache
.mypy_cache
.ruff_cache
.workbuddy-ai

# Never bake a real mailbox credential or database into an image.
data/
.env
.env.*
credentials.json
token.json
.streamlit/secrets.toml

# Not needed at runtime.
tests/
docs/
tmp/
node_modules/
logs/
*.log
*.db
