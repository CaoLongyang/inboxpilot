# ============================================================
# InboxPilot — environment template
# Copy to .env and fill in real values. NEVER commit .env.
# ============================================================

# --- App ---
APP_ENV=local
APP_BASE_URL=http://localhost:8000
LOG_LEVEL=INFO
# Comma-separated list. Frontend origin allowed to call the API.
CORS_ORIGINS=http://localhost:8501
# Where the OAuth callback sends the browser back to.
FRONTEND_URL=http://localhost:8501
# SQLite file path (relative to repo root)
DATABASE_PATH=data/inboxpilot.db

# --- Nebius Token Factory (OpenAI-compatible) ---
# Base URL confirmed from the official Token Factory quickstart (2026-10).
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# Fast/cheap model for classification + summary (Nemotron Super / Nano class).
# Confirm with: python scripts/check_nebius.py --list
NEBIUS_MODEL_FAST=nvidia/nemotron-3-super-120b-a12b
# Strong reasoning model, used only for WhatIf / planning (Nemotron Ultra class)
NEBIUS_MODEL_REASONING=nvidia/Nemotron-3-Ultra-550b-a55b
NEBIUS_TIMEOUT_SECONDS=60
NEBIUS_MAX_RETRIES=2

# --- Google / Gmail OAuth ---
# Put the downloaded OAuth client JSON outside the repo, or set the fields below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match a URI registered in Google Cloud Console.
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
# Space-separated scopes. Keep minimal: read mail + create drafts only.
GOOGLE_SCOPES=https://www.googleapis.com/auth/gmail.readonly https://www.googleapis.com/auth/gmail.compose

# --- Demo account (for judges, 2026-12-01 -> 2026-12-15) ---
# Refresh token of the pre-authorized demo account. Server-side only.
# Leave empty during local development; the local OAuth flow is used instead.
DEMO_REFRESH_TOKEN=
DEMO_ACCOUNT_EMAIL=

# --- Safety / limits ---
# Max emails fetched per list request.
MAX_EMAILS_PER_REQUEST=20
# Automated sending is intentionally impossible in MVP.
ALLOW_EMAIL_SEND=false
